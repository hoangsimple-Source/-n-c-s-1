{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Run LoginForm",
      "request": "launch",
      "mainClass": "LoginForm",
      "preLaunchTask": "Compile Java Sources",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "classPaths": [
        "${workspaceFolder}/bin",
        "${workspaceFolder}/lib/mssql-jdbc-13.2.1.jre11.jar"
      ],
      "stopOnEntry": false,
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
