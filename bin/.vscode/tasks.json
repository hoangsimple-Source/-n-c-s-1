{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Java Sources",
      "type": "shell",
      "command": "cmd /c \"cd /d \"${workspaceFolder}\" && javac -encoding UTF-8 -cp \".;lib/*\" -d bin *.java\"",
      "problemMatcher": [
        "$javac"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
